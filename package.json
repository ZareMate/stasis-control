{
  "name": "stasis-control",
  "version": "1.0.0",
  "private": true,
  "description": "Web dashboard and ComputerCraft WebSocket controller for Minecraft ender-pearl stasis chambers.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "bot": "node --dns-result-order=ipv4first bot/index.js",
    "stt:setup": "bash bot/setup-whisper.sh"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "ws": "^8.18.3",
    "discord.js": "^14.27.0",
    "@discordjs/voice": "^0.19.2",
    "prism-media": "^1.3.5",
    "opusscript": "^0.0.8"
  }
}
